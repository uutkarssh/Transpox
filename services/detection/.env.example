# Primary pothole inference backend
HF_SPACE=Utkarssh/transpox-api
# Optional: only set this if the Space is private or rate-limited
# HF_TOKEN=

# Keep a lower default to avoid dropping weaker real potholes.
TRANPOX_CONFIDENCE=0.25

# Optional local fallbacks
TRANPOX_MODEL=models/pothole.pt
TRANPOX_VEHICLE_MODEL=models/vehicles.pt
